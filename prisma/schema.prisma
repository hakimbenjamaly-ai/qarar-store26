// منصة قرار – هيكل قاعدة البيانات
// السجلات الأربعة المستقلة: Order (طلب العميل) · PurchaseOrder (أمر الشراء من المورد)
// · Shipment (الشحنة الدولية) · Delivery (طلب التوصيل المحلي). ترتبط ببعضها عبر OrderItem.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── الكتالوج ─────────────────────────

model Category {
  id        String     @id @default(cuid())
  name      String
  nameEn    String     @default("")
  slug      String     @unique
  imageUrl  String?
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum SourcingType {
  LOCAL_STOCK // متوفر محلياً (مخزون في ليبيا)
  IMPORT_ON_ORDER // استيراد عند الطلب
}

model Product {
  id              String           @id @default(cuid())
  sku             String           @unique
  name            String
  nameEn          String           @default("") // الاسم بالإنجليزية (اختياري)
  slug            String           @unique
  description     String           @default("")
  descriptionEn   String           @default("")
  specs           Json             @default("[]") // [{label, value}]
  countryOfOrigin String?
  sourcingType    SourcingType     @default(IMPORT_ON_ORDER)
  leadTimeDays    Int? // مدة التوريد التقديرية بالأيام
  published       Boolean          @default(false)
  featured        Boolean          @default(false)
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          ProductImage[]
  variants        ProductVariant[]
  reviews         Review[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId])
  @@index([published, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id               String              @id @default(cuid())
  sku              String              @unique
  name             String              @default("") // مثل: "أحمر / XL" — فارغ للمنتج بلا خيارات
  nameEn           String              @default("")
  size             String?
  color            String?
  price            Decimal             @db.Decimal(12, 2) // سعر البيع بالدينار الليبي
  compareAtPrice   Decimal?            @db.Decimal(12, 2) // السعر قبل الخصم
  stockQty         Int                 @default(0) // الكمية المتاحة محلياً
  active           Boolean             @default(true)
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cost             ProductCost?
  orderItems       OrderItem[]
  inventoryMoves   InventoryMovement[]
  supplierProducts SupplierProduct[]
  purchaseItems    PurchaseOrderItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

// بيانات داخلية — لا تُقرأ أبداً من واجهة المتجر
model ProductCost {
  id               String         @id @default(cuid())
  variantId        String         @unique
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplierId       String?
  supplier         Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchasePrice    Decimal        @default(0) @db.Decimal(12, 2)
  purchaseCurrency String         @default("USD")
  shippingCost     Decimal        @default(0) @db.Decimal(12, 2) // للوحدة
  shippingCurrency String         @default("USD")
  otherFeesLyd     Decimal        @default(0) @db.Decimal(12, 2)
  localDeliveryLyd Decimal        @default(0) @db.Decimal(12, 2) // إذا كان التوصيل على المتجر
  marginType       MarginType     @default(PERCENT)
  marginValue      Decimal        @default(0) @db.Decimal(12, 2)
  updatedAt        DateTime       @updatedAt
}

enum MarginType {
  PERCENT
  FIXED
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  body       String   @default("")
  approved   Boolean  @default(false)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([productId, orderId])
}

// ───────────────────────── العملاء والطلبات ─────────────────────────

model City {
  id              String    @id @default(cuid())
  name            String    @unique
  nameEn          String    @default("")
  active          Boolean   @default(true)
  coveredByNawras Boolean   @default(false)
  deliveryFee     Decimal   @default(0) @db.Decimal(12, 2)
  sortOrder       Int       @default(0)
  regions         Region[]
  addresses       Address[]
}

model Region {
  id     String @id @default(cuid())
  name   String
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, name])
}

model Customer {
  id        String    @id @default(cuid())
  fullName  String
  phone     String    @unique
  whatsapp  String?
  notes     String    @default("")
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([fullName])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cityId     String
  city       City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  region     String   @default("")
  details    String
  landmark   String   @default("")
  createdAt  DateTime @default(now())
}

enum OrderStatus {
  NEW // طلب جديد
  CONFIRMING // قيد تأكيد الطلب
  PURCHASING // قيد الشراء من المورد
  PURCHASED // تم شراء المنتج
  INTL_SHIPPING // قيد الشحن الدولي
  ARRIVED_LIBYA // وصل إلى ليبيا
  HANDED_TO_NAWRAS // تم تسليمه إلى النورس
  IN_DISTRIBUTION // قيد التوزيع
  OUT_FOR_DELIVERY // خرج للتوصيل
  DELIVERED // تم التسليم للعميل
  DELIVERY_FAILED // تعذر التسليم
  RETURNED // طلب مرتجع
  CANCELLED // طلب ملغى
}

model Order {
  id              String               @id @default(cuid())
  number          String               @unique // ORD-2026-00001
  status          OrderStatus          @default(NEW)
  locale          String               @default("ar") // لغة العميل عند الطلب: ar | en
  customerId      String
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // لقطة من العنوان وقت الطلب
  shipName        String
  shipPhone       String
  shipWhatsapp    String?
  shipCity        String
  shipRegion      String               @default("")
  shipAddress     String
  shipLandmark    String               @default("")
  customerNote    String               @default("")
  internalNote    String               @default("")
  subtotal        Decimal              @db.Decimal(12, 2)
  discount        Decimal              @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal              @default(0) @db.Decimal(12, 2)
  total           Decimal              @db.Decimal(12, 2)
  paymentMethodId String?
  paymentMethod   PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  depositRequired Decimal              @default(0) @db.Decimal(12, 2)
  items           OrderItem[]
  history         OrderStatusHistory[]
  payments        Payment[]
  deliveries      Delivery[]
  reviews         Review[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([shipPhone])
}

model OrderItem {
  id                String               @id @default(cuid())
  orderId           String
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName       String // لقطة وقت الطلب
  variantName       String               @default("")
  sku               String
  quantity          Int
  unitPrice         Decimal              @db.Decimal(12, 2)
  estUnitCostLyd    Decimal?             @db.Decimal(12, 2) // لقطة التكلفة التقديرية (داخلي)
  actualUnitCostLyd Decimal?             @db.Decimal(12, 2) // التكلفة الفعلية من أمر الشراء والشحنة (داخلي)
  sourcing          SourcingType
  status            OrderStatus          @default(NEW)
  purchaseItems     PurchaseOrderItem[]
  deliveryItems     DeliveryItem[]
  returns           Return[]
  history           OrderStatusHistory[]

  @@index([status])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String?
  orderItem   OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String       @default("")
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

model PaymentMethod {
  id             String    @id @default(cuid())
  code           String    @unique // COD, BANK_TRANSFER, ONLINE
  name           String
  nameEn         String    @default("")
  instructions   String    @default("")
  instructionsEn String    @default("")
  enabled        Boolean   @default(false)
  sortOrder      Int       @default(0)
  orders         Order[]
  payments       Payment[]
}

enum PaymentKind {
  DEPOSIT // عربون
  PAYMENT // دفعة
  REFUND // استرداد
}

model Payment {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind         PaymentKind
  amount       Decimal        @db.Decimal(12, 2)
  methodId     String?
  method       PaymentMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  reference    String         @default("")
  receiptUrl   String?
  note         String         @default("")
  settlementId String?
  settlement   Settlement?    @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  receivedAt   DateTime       @default(now())
  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
}

enum InventoryMoveType {
  IN // وارد
  OUT // صادر (بيع)
  RESERVE // حجز
  RELEASE // فك حجز
  RETURN // مرتجع
  ADJUST // تسوية جرد
}

model InventoryMovement {
  id        String            @id @default(cuid())
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      InventoryMoveType
  quantity  Int // موجب أو سالب حسب الأثر على المتاح
  reference String            @default("") // رقم الطلب أو أمر الشراء...
  note      String            @default("")
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())

  @@index([variantId])
}

// ───────────────────────── الموردون والمشتريات (المرحلة ٢) ─────────────────────────

enum IntegrationMode {
  MANUAL
  FILE
  API
}

model Supplier {
  id              String            @id @default(cuid())
  name            String
  platform        String            @default("") // Alibaba / AliExpress / وسيط 1688 / مباشر
  contactName     String            @default("")
  phone           String            @default("")
  email           String            @default("")
  website         String            @default("")
  currency        String            @default("USD")
  integrationMode IntegrationMode   @default(MANUAL)
  notes           String            @default("")
  active          Boolean           @default(true)
  products        SupplierProduct[]
  purchaseOrders  PurchaseOrder[]
  costs           ProductCost[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model SupplierProduct {
  id            String         @id @default(cuid())
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url           String         @default("")
  price         Decimal        @db.Decimal(12, 2)
  currency      String
  available     Boolean        @default(true)
  lastCheckedAt DateTime?

  @@unique([supplierId, variantId])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_SHIPPED
  SHIPPED
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  number          String              @unique // PO-2026-00001
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierOrderNo String              @default("")
  invoiceNo       String              @default("")
  currency        String
  exchangeRate    Decimal?            @db.Decimal(14, 6) // دينار لكل وحدة عملة
  total           Decimal             @default(0) @db.Decimal(12, 2)
  status          PurchaseOrderStatus @default(DRAFT)
  orderedAt       DateTime?
  notes           String              @default("")
  items           PurchaseOrderItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model PurchaseOrderItem {
  id                String         @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderItemId       String? // فارغ إذا كان الشراء للمخزون
  orderItem         OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  quantity          Int
  unitPrice         Decimal        @db.Decimal(12, 2)
  landedUnitCostLyd Decimal?       @db.Decimal(12, 2) // الشراء + نصيب الشحن والجمارك، بالدينار
  receivedQty       Int            @default(0) // المستلم في ليبيا (لبنود المخزون يضاف للمخزون)
  shipmentItems     ShipmentItem[]
}

// ───────────────────────── الشحن الدولي (المرحلة ٢) ─────────────────────────

model Carrier {
  id              String          @id @default(cuid())
  name            String
  trackingUrl     String          @default("") // يحتوي {tracking}
  integrationMode IntegrationMode @default(MANUAL)
  active          Boolean         @default(true)
  shipments       Shipment[]
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  CUSTOMS
  ARRIVED_LIBYA
  RECEIVED
  CANCELLED
}

enum CostAllocation {
  BY_WEIGHT
  BY_VALUE
  BY_QUANTITY
}

model Shipment {
  id              String          @id @default(cuid())
  number          String          @unique // SHP-2026-00001
  carrierId       String?
  carrier         Carrier?        @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  trackingNumber  String          @default("")
  originCountry   String          @default("")
  shippedAt       DateTime?
  expectedArrival DateTime?
  arrivedAt       DateTime?
  weightKg        Decimal?        @db.Decimal(10, 3)
  volumeCbm       Decimal?        @db.Decimal(10, 4)
  cost            Decimal         @default(0) @db.Decimal(12, 2)
  costCurrency    String          @default("USD")
  exchangeRate    Decimal?        @db.Decimal(14, 6)
  customsFeesLyd  Decimal         @default(0) @db.Decimal(12, 2)
  allocation      CostAllocation  @default(BY_VALUE)
  status          ShipmentStatus  @default(PENDING)
  notes           String          @default("")
  items           ShipmentItem[]
  events          ShipmentEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ShipmentItem {
  id                  String            @id @default(cuid())
  shipmentId          String
  shipment            Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  quantity            Int
  allocatedCostLyd    Decimal?          @db.Decimal(12, 2)
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  occurredAt  DateTime
  location    String   @default("")
  description String
  source      String   @default("manual") // manual / api
  createdAt   DateTime @default(now())
}

// ───────────────────────── التوزيع المحلي – النورس (المرحلة ٣) ─────────────────────────

model DeliveryPartner {
  id              String          @id @default(cuid())
  name            String
  phone           String          @default("")
  email           String          @default("")
  address         String          @default("")
  integrationMode IntegrationMode @default(FILE)
  defaultFee      Decimal         @default(0) @db.Decimal(12, 2) // أجرة التوصيل المتفق عليها لكل طرد
  notes           String          @default("")
  active          Boolean         @default(true)
  points          DeliveryPoint[]
  handovers       Handover[]
  deliveries      Delivery[]
  settlements     Settlement[]
  users           User[]
}

model DeliveryPoint {
  id         String          @id @default(cuid())
  partnerId  String
  partner    DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name       String
  city       String
  address    String          @default("")
  phone      String          @default("")
  active     Boolean         @default(true)
  deliveries Delivery[]
}

model Handover {
  id          String          @id @default(cuid())
  number      String          @unique // HND-2026-00001
  partnerId   String
  partner     DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  handedAt    DateTime
  receivedBy  String          @default("")
  parcelCount Int             @default(0)
  notes       String          @default("")
  deliveries  Delivery[]
}

enum DeliveryStatus {
  READY
  HANDED_OVER
  IN_DISTRIBUTION
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

model Delivery {
  id            String          @id @default(cuid())
  number        String          @unique // DLV-2026-00001
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  partnerId     String
  partner       DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  handoverId    String?
  handover      Handover?       @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  waybillNo     String          @default("")
  courierName   String          @default("")
  fee           Decimal         @default(0) @db.Decimal(12, 2)
  codAmount     Decimal         @default(0) @db.Decimal(12, 2)
  collected     Decimal?        @db.Decimal(12, 2)
  status        DeliveryStatus  @default(READY)
  deliveredAt   DateTime?
  failureReason String          @default("")
  attempts      Int             @default(0)
  pointId       String?
  point         DeliveryPoint?  @relation(fields: [pointId], references: [id], onDelete: SetNull)
  settlementId  String?
  settlement    Settlement?     @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  items         DeliveryItem[]
  returns       Return[]
  events        DeliveryEvent[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model DeliveryEvent {
  id         String         @id @default(cuid())
  deliveryId String
  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status     DeliveryStatus
  note       String         @default("")
  source     String         @default("admin") // admin | partner | import
  userId     String?
  createdAt  DateTime       @default(now())

  @@index([deliveryId])
}

model DeliveryItem {
  id           String    @id @default(cuid())
  deliveryId   String
  delivery     Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity     Int
  deliveredQty Int       @default(0)
}

model Return {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  deliveryId  String?
  delivery    Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  quantity    Int
  reason      String
  restocked   Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Settlement {
  id           String          @id @default(cuid())
  number       String          @unique // STL-2026-00001
  reference    String          @default("") // رقم التحويل أو إيصال الاستلام
  createdAt    DateTime        @default(now())
  partnerId    String
  partner      DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  periodFrom   DateTime
  periodTo     DateTime
  collected    Decimal         @db.Decimal(12, 2)
  feesDeducted Decimal         @db.Decimal(12, 2)
  netReceived  Decimal         @db.Decimal(12, 2)
  receivedAt   DateTime?
  notes        String          @default("")
  deliveries   Delivery[]
  payments     Payment[]
}

// ───────────────────────── النظام والصلاحيات ─────────────────────────

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  permissions String[] // مفاتيح الصلاحيات، انظر src/lib/permissions.ts
  system      Boolean  @default(false) // دور أساسي لا يُحذف
  users       User[]
}

model User {
  id                String               @id @default(cuid())
  name              String
  email             String               @unique
  passwordHash      String
  active            Boolean              @default(true)
  roleId            String
  role              Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  deliveryPartnerId String? // لموظفي النورس: يرون توصيلات شركتهم فقط
  deliveryPartner   DeliveryPartner?     @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  sessions          Session[]
  auditLogs         AuditLog[]
  statusChanges     OrderStatusHistory[]
  payments          Payment[]
  inventoryMoves    InventoryMovement[]
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model Session {
  id        String   @id // sha256 للرمز
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // create / update / delete / login / status_change ...
  entity    String
  entityId  String   @default("")
  before    Json?
  after     Json?
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  key   String @id
  value Json
}

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String
  rateToLyd Decimal  @db.Decimal(14, 6)
  source    String   @default("manual")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([currency, createdAt])
}

model Counter {
  key   String @id // ORD-2026
  value Int    @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  subject   String   @default("")
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  channel   String   @default("dashboard") // dashboard / email / sms / whatsapp
  event     String
  title     String
  body      String   @default("")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// مرفقات عامة: فواتير الموردين، بوالص الشحن، إيصالات...
model Attachment {
  id        String   @id @default(cuid())
  entity    String // PurchaseOrder / Shipment / Delivery ...
  entityId  String
  kind      String   @default("other") // invoice / waybill / receipt / other
  name      String
  url       String
  userId    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
