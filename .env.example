# رابط قاعدة بيانات PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/qarar"
# مجلد حفظ الصور والملفات المرفوعة (خارج مجلد الكود)
UPLOAD_DIR="./uploads"
# اجعلها true عند التشغيل خلف HTTPS
COOKIE_SECURE="false"
# رابط الموقع العام (لروابط التتبع في رسائل العملاء والبريد)
SITE_URL="http://localhost:3000"
# مفتاح مسار /api/cron/notify
CRON_SECRET=""
# بريد إشعارات الإدارة (اختياري؛ بدونه تبقى الإشعارات داخل اللوحة)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
